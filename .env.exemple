# Configuration Firebase (console Firebase > Paramètres du projet > Vos applications).
# Sans ces variables, le site affiche « Application non configurée ».
# Pour une démonstration avec données fictives uniquement : VITE_MODE_DEMO=oui
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Région des Cloud Functions
VITE_FIREBASE_REGION=europe-west1
# Analyse multimodale des emplois du temps (fonction serveur, offre Firebase Blaze + clé Anthropic) : « oui » pour l'activer
VITE_ANALYSE_MULTIMODALE=
