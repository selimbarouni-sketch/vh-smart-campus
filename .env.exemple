# Configuration Firebase (console Firebase > Paramètres du projet > Vos applications).
# Sans ces variables, l'application démarre en MODE DÉMONSTRATION (données fictives).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Région des Cloud Functions
VITE_FIREBASE_REGION=europe-west1
