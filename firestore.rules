rules_version = '2';
// Règles de sécurité de VH Smart Campus.
// Les droits dépendent du rôle stocké dans utilisateurs/{uid}.roles (modifiable par un administrateur uniquement).
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function cheminProfil() { return /databases/$(database)/documents/utilisateurs/$(request.auth.uid); }
    function profil() { return get(cheminProfil()).data; }
    function actif() { return connecte() && exists(cheminProfil()) && profil().actif == true; }
    function role(r) { return actif() && r in profil().roles; }
    function admin() { return role('admin'); }
    function unDe(roles) { return actif() && profil().roles.hasAny(roles); }
    function eleve(id) { return get(/databases/$(database)/documents/eleves/$(id)).data; }
    // « service » est un mot réservé du langage des règles : accès par crochets.
    function idPassage(d) { return d.date + '_' + d['service'] + '_' + d.eleveId; }

    function cheminInstallation() { return /databases/$(database)/documents/config/installation; }

    match /utilisateurs/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || admin();
      allow write: if admin();
      // Première mise en service : le tout premier compte se déclare administrateur,
      // dans le même lot que la création de config/installation (impossible ensuite).
      allow create: if connecte() && request.auth.uid == uid
        && !exists(cheminInstallation()) && existsAfter(cheminInstallation())
        && request.resource.data.roles == ['admin'] && request.resource.data.actif == true;
    }

    match /config/installation {
      allow get: if true;
      allow create: if connecte() && !exists(cheminInstallation())
        && request.resource.data.par == request.auth.uid
        && getAfter(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.roles == ['admin'];
      allow update, delete: if false;
    }

    // L'administrateur lit tous les réglages (sauvegarde complète).
    match /config/{reglage} {
      allow read: if admin();
    }

    // Identité de l'établissement (nom, logos, couleur) : affichée avant la connexion.
    match /config/etablissement {
      allow get: if true;
      allow write: if admin();
    }

    // Identité de l'élève : nom, prénom, classe, régime. Lisible par les agents de scan.
    match /eleves/{id} {
      allow read: if unDe(['admin', 'cantine', 'vie_scolaire', 'gestion_eleves', 'gestion_edt']);
      allow write: if unDe(['admin', 'gestion_eleves']);
    }

    // Données pédagogiques (groupes) : jamais accessibles au personnel de cantine.
    match /scolarites/{id} {
      allow read: if unDe(['admin', 'vie_scolaire', 'gestion_eleves', 'gestion_edt']);
      allow write: if unDe(['admin', 'gestion_eleves']);
    }
    match /groupes/{id} {
      allow read: if unDe(['admin', 'vie_scolaire', 'gestion_eleves', 'gestion_edt']);
      allow write: if unDe(['admin', 'gestion_eleves', 'gestion_edt']);
    }

    // Jetons QR : lecture unitaire pour scanner, jamais de liste pour les agents.
    match /qr_jetons/{jeton} {
      allow get: if unDe(['admin', 'cantine', 'vie_scolaire', 'gestion_edt', 'gestion_eleves']);
      allow list: if unDe(['admin', 'gestion_eleves']);
      allow write: if unDe(['admin', 'gestion_eleves']);
    }

    match /config/cantine {
      allow read: if unDe(['admin', 'cantine', 'vie_scolaire', 'gestion_eleves']);
      allow write: if admin();
    }
    match /config/calendrier {
      allow read: if actif();
      allow write: if unDe(['admin', 'gestion_edt']);
    }

    // Passages confirmés : l'identifiant date_service_eleve rend tout second passage impossible.
    match /cantine_passages/{id} {
      allow get: if unDe(['admin', 'cantine', 'vie_scolaire', 'gestion_eleves']);
      allow list: if unDe(['admin', 'vie_scolaire', 'gestion_eleves']);
      // L'administrateur peut recréer des passages lors d'une restauration de sauvegarde.
      allow create: if request.resource.data.statut == 'confirme'
        && id == idPassage(request.resource.data)
        && (admin() || (unDe(['cantine'])
          && request.resource.data.agentUid == request.auth.uid
          && eleve(request.resource.data.eleveId).actif == true
          // Régime sans cantine : passage autorisé uniquement aux dates listées (ex. lundis d'un club).
          && (eleve(request.resource.data.eleveId).cantineAutorisee == true
            || eleve(request.resource.data.eleveId).get('datesCantine', []).hasAny([request.resource.data.date]))));
      allow update, delete: if false;
    }
    match /cantine_anomalies/{id} {
      allow list, get: if unDe(['admin', 'vie_scolaire', 'gestion_eleves']);
      allow create: if (admin() || (unDe(['cantine']) && request.resource.data.agentUid == request.auth.uid))
        && request.resource.data.statut in ['refuse', 'doublon'];
      allow update, delete: if false;
    }

    match /edt_imports/{id} {
      allow read, create, update: if unDe(['admin', 'gestion_edt']);
      allow delete: if admin();
    }
    // Documents sources des emplois du temps, découpés en morceaux (pas de stockage de fichiers payant).
    match /edt_sources/{id} {
      allow read, create, update: if unDe(['admin', 'gestion_edt']);
      allow delete: if admin();
      match /morceaux/{n} {
        allow read, create, update: if unDe(['admin', 'gestion_edt']);
        allow delete: if admin();
      }
    }

    match /edt_versions/{id} {
      allow read: if unDe(['admin', 'vie_scolaire', 'gestion_edt']);
      allow create, update: if unDe(['admin', 'gestion_edt']);
      allow delete: if false;
    }
    match /edt_modifications/{id} {
      allow read: if unDe(['admin', 'vie_scolaire', 'gestion_edt']);
      allow create: if admin() || (unDe(['vie_scolaire', 'gestion_edt']) && request.resource.data.creePar == request.auth.uid);
      // Seule l'annulation d'un changement est permise ensuite (champ "actif").
      allow update: if unDe(['admin', 'vie_scolaire', 'gestion_edt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif']);
      allow delete: if false;
    }
  }
}
