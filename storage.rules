rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function roles() {
      return firestore.get(/databases/(default)/documents/utilisateurs/$(request.auth.uid)).data.roles;
    }
    function gestionEdt() {
      return request.auth != null && roles().hasAny(['admin', 'gestion_edt']);
    }
    // Documents sources des emplois du temps (PDF, JPG, PNG ; 25 Mo maximum).
    match /edt_sources/{importId}/{fichier} {
      allow read: if gestionEdt();
      allow create: if gestionEdt()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png)');
      allow update, delete: if false;
    }
  }
}
